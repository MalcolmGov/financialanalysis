# ── Shared ────────────────────────────────────────────────────────────────────
# Railway Postgres (project "results-studio", EU/Amsterdam). Two forms:
#   • Portal + local schema pushes → PUBLIC TCP proxy URL
#       (Railway var DATABASE_PUBLIC_URL, host *.proxy.rlwy.net) — TLS required.
#   • Worker deployed on Railway → INTERNAL URL (postgres.railway.internal:5432),
#       which never leaves Railway's private network.
DATABASE_URL=postgresql://user:pass@host.proxy.rlwy.net:PORT/railway

# Vercel Blob — PRIVATE store only (EU region; fixed at creation)
BLOB_READ_WRITE_TOKEN=

# ── apps/portal ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
AUTH_SECRET=                       # openssl rand -base64 32
OPERATOR_EMAILS=you@example.com    # comma-separated allowlist (required in prod)
WORKER_BASE_URL=http://localhost:8000
WORKER_SERVICE_TOKEN=              # shared secret, portal -> worker
WEBHOOK_HMAC_KEY=                  # worker -> portal webhook signing
APP_BASE_URL=http://localhost:3000 # must be the public portal URL in prod

# Workflow DevKit — durable runs on a long-lived Next.js process (Railway).
# See https://useworkflow.dev — postgres world polls via instrumentation.ts.
WORKFLOW_TARGET_WORLD=@workflow/world-postgres
# Optional; defaults to DATABASE_URL when unset.
WORKFLOW_POSTGRES_URL=

# Local-only: skip real Blob/DB side effects so the pipeline can dry-run.
# MOCK_BLOB=1

# ── services/worker ───────────────────────────────────────────────────────────
# Also needs DATABASE_URL, BLOB_READ_WRITE_TOKEN, WORKER_SERVICE_TOKEN, WEBHOOK_HMAC_KEY
# QUEUE_BACKEND=postgres
# BLOB_BACKEND=vercel
# ALLOW_INSECURE_WORKER=1   # local/dev only — never set in production
