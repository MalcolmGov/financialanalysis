{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "ArtifactRef@1"
    },
    "artifact_id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "source_pdf",
        "extraction_result",
        "design_dna",
        "brief",
        "brand_assets",
        "prototype_spec",
        "prototype",
        "blueprint",
        "doc_model",
        "site_plan",
        "render_tree",
        "number_audit",
        "qa_report",
        "export_bundle"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "blob_path": {
      "type": "string"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "content_type": {
      "type": "string"
    },
    "meta": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "schema",
    "artifact_id",
    "kind",
    "version",
    "blob_path",
    "sha256",
    "bytes",
    "content_type",
    "meta"
  ],
  "additionalProperties": false
}
