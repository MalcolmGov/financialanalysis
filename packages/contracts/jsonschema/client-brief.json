{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "brief/1"
    },
    "project_id": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "report_title": {
      "type": "string"
    },
    "audience": {
      "type": "string",
      "enum": [
        "investors",
        "media",
        "both"
      ]
    },
    "must_include_sections": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tone_notes": {
      "default": "",
      "type": "string"
    },
    "theme_preference": {
      "default": "auto",
      "type": "string",
      "enum": [
        "auto",
        "light",
        "dark",
        "both"
      ]
    },
    "reference_sites": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "logo_blob_path": {
      "default": null,
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "hero_blob_path": {
      "default": null,
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "language": {
      "default": "en-ZA",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "company_name",
    "report_title",
    "audience",
    "must_include_sections",
    "tone_notes",
    "theme_preference",
    "reference_sites",
    "logo_blob_path",
    "hero_blob_path",
    "language"
  ],
  "additionalProperties": false
}
