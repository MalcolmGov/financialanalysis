            "additionalProperties": false
          }
        },
        "required": [
          "page_no",
          "width_pt",
          "height_pt",
          "image"
        ],
        "additionalProperties": false
      }
    },
    "body": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "furniture": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "tables": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "caption_block": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "prov": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema1"
            }
          },
          "num_rows": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "num_cols": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "cells": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "r": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "c": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "row_span": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "col_span": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "text": {
                  "type": "string"
                },
                "is_col_header": {
                  "type": "boolean"
                },
                "is_row_header": {
                  "type": "boolean"
                },
                "is_section": {
                  "type": "boolean"
                },
                "bbox": {
                  "$ref": "#/$defs/__schema2"
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "r",
                "c",
                "row_span",
                "col_span",
                "text",
                "is_col_header",
                "is_row_header",
                "is_section"
              ],
              "additionalProperties": false
            }
          },
          "column_roles": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "caption_block",
          "prov",
          "num_rows",
          "num_cols",
          "cells",
          "column_roles"
        ],
        "additionalProperties": false
      }
    },
    "figures": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "caption_block": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
