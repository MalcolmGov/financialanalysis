    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "page_no": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "width_pt": {
            "type": "number"
          },
          "height_pt": {
            "type": "number"
          },
          "image": {
            "type": "object",
            "properties": {
              "blob_path": {
                "type": "string"
              },
              "width_px": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "height_px": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "scale": {
                "type": "number"
              },
              "px_per_pt": {
                "type": "number"
              }
            },
            "required": [
              "blob_path",
              "width_px",
              "height_px",
              "scale",
              "px_per_pt"
