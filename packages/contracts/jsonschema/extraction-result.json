        "bbox": {
          "$ref": "#/$defs/__schema2"
        },
        "charspan": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          ]
        }
      },
      "required": [
        "page_no",
        "bbox"
      ],
      "additionalProperties": false
