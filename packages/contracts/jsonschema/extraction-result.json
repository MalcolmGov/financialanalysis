        "type": {
          "type": "string",
          "enum": [
            "heading",
            "paragraph",
            "list",
            "list_item",
            "caption",
            "footnote",
            "code",
            "formula",
            "table_ref",
            "figure_ref",
            "page_header",
            "page_footer"
          ]
        },
        "level": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "text": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "prov": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "id",
        "type",
        "prov",
        "children"
