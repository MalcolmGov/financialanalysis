    "__schema2": {
      "type": "object",
      "properties": {
        "l": {
          "type": "number"
        },
        "t": {
          "type": "number"
        },
        "r": {
          "type": "number"
        },
        "b": {
          "type": "number"
        }
      },
      "required": [
        "l",
        "t",
        "r",
        "b"
      ],
      "additionalProperties": false
    }
  }
}
