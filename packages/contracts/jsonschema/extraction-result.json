          "classification": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "logo",
                  "banner",
                  "chart",
                  "photo",
                  "decorative"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "caption_block",
          "prov",
          "image",
          "classification"
        ],
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
