              "mime": {
                "type": "string"
              },
              "width_px": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "height_px": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "blob_path",
              "mime",
              "width_px",
              "height_px"
            ],
            "additionalProperties": false
