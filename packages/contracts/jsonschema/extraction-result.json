{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "extraction_id": {
      "type": "string"
    },
    "org_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "properties": {
        "blob_path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "page_count": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "pdf_meta": {
          "type": "object",
          "properties": {
            "title": {
              "default": "",
              "type": "string"
            },
            "producer": {
              "default": "",
              "type": "string"
            },
            "created": {
              "default": "",
              "type": "string"
            },
            "modified": {
              "default": "",
              "type": "string"
            }
          },
          "required": [
            "title",
            "producer",
            "created",
            "modified"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "blob_path",
        "sha256",
        "size_bytes",
        "page_count",
        "pdf_meta"
      ],
      "additionalProperties": false
    },
    "engine": {
      "type": "object",
      "properties": {
        "docling_version": {
          "type": "string"
        },
        "backend": {
          "type": "string"
        },
        "table_mode": {
          "type": "string",
          "enum": [
            "accurate",
            "fast"
          ]
        },
        "ocr_applied": {
          "type": "boolean"
        },
        "ocr_engine": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "docling_version",
        "backend",
        "table_mode",
        "ocr_applied",
        "ocr_engine"
      ],
      "additionalProperties": false
