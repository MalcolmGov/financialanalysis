              "title": {
                "type": "string"
              },
              "level": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "page_span": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                ]
              },
              "block_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "title",
              "level",
              "page_span",
              "block_ids"
            ],
            "additionalProperties": false
          }
        },
        "key_figures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "value_raw": {
                "type": "string"
              },
              "src_ref": {
                "type": "string"
              },
              "comparative_raw": {
                "type": "string"
              },
              "unit": {
                "type": "string"
              },
              "page": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "id",
              "label",
              "value_raw",
              "src_ref",
              "page"
            ],
            "additionalProperties": false
          }
        },
        "numeric_annotations": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "value": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "negative": {
                "type": "boolean"
              },
              "nil": {
                "type": "boolean"
              }
            },
            "required": [
              "value",
              "negative",
              "nil"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "sections",
        "key_figures",
        "numeric_annotations"
      ],
      "additionalProperties": false
