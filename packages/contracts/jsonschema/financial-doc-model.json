{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "docmodel/1"
    },
    "doc_model_id": {
      "type": "string"
    },
    "extraction_id": {
      "type": "string"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "meta": {
      "type": "object",
      "properties": {
        "company": {
          "type": "string"
        },
        "period_label": {
          "type": "string"
        },
        "doc_kind": {
          "type": "string",
          "enum": [
            "interim_unaudited",
            "interim_reviewed",
            "annual_audited"
          ]
        },
        "currency": {
          "type": "string"
        }
      },
      "required": [
        "company",
        "period_label",
        "doc_kind",
        "currency"
      ],
      "additionalProperties": false
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^doc:"
          },
          "kind": {
            "$ref": "#/$defs/__schema0"
          },
          "statement_type": {
            "type": "string",
            "enum": [
              "pnl_oci",
              "financial_position",
              "changes_in_equity",
              "cash_flows"
            ]
          },
          "note_number": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "title": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "src_ref": {
                "$ref": "#/$defs/__schema1"
              }
            },
            "required": [
              "text",
              "src_ref"
            ],
            "additionalProperties": false
          },
          "blocks": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "heading",
                    "paragraph",
                    "list",
                    "signoff",
                    "table"
                  ]
                },
                "text": {
                  "type": "string"
                },
                "src_ref": {
                  "$ref": "#/$defs/__schema1"
                },
                "text_hash": {
                  "type": "string"
                },
                "table_ref": {
                  "type": "string"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            }
          },
          "items": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "src_ref": {
                      "$ref": "#/$defs/__schema1"
                    }
                  },
                  "required": [
                    "text",
                    "src_ref"
                  ],
                  "additionalProperties": false
                },
                "value": {
                  "type": "object",
                  "properties": {
                    "raw": {
                      "type": "string"
                    },
                    "src_ref": {
                      "$ref": "#/$defs/__schema1"
                    }
                  },
                  "required": [
                    "raw",
                    "src_ref"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "id",
                "label",
                "value"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "kind",
          "blocks",
          "items"
        ],
        "additionalProperties": false
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^doc:"
          },
          "src_table": {
            "$ref": "#/$defs/__schema1"
          },
          "must_appear": {
            "type": "boolean"
          },
          "table_type": {
            "type": "string",
            "enum": [
              "statement",
              "note",
              "reconciliation",
              "facts",
              "sensitivity",
              "wide"
            ]
          },
          "header_matrix": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "raw": {
                    "type": "string"
                  },
                  "col_span": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "row_span": {
                    "default": 1,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "src_ref": {
                    "$ref": "#/$defs/__schema1"
                  }
                },
                "required": [
                  "raw",
                  "col_span",
                  "row_span",
                  "src_ref"
                ],
                "additionalProperties": false
              }
            }
          },
          "unit_context": {
            "type": "object",
            "properties": {
              "default": {
                "type": "string"
              },
              "per_row": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "default",
              "per_row"
            ],
            "additionalProperties": false
          },
          "row_groups": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "rows": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "subtotal_row": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "label",
                "rows",
                "subtotal_row"
              ],
              "additionalProperties": false
            }
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "cells": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "src_ref": {
                        "$ref": "#/$defs/__schema1"
                      },
                      "raw": {
                        "type": "string"
                      },
                      "kind": {
                        "type": "string",
                        "enum": [
                          "text",
                          "number",
                          "nil",
                          "noteRef"
                        ]
                      },
                      "normalized": {
                        "type": "object",
                        "properties": {
                          "value": {
                            "anyOf": [
                              {
                                "type": "number"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "negative": {
                            "type": "boolean"
                          },
                          "nil": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "value",
                          "negative",
                          "nil"
                        ],
                        "additionalProperties": false
                      },
                      "footnote_refs": {
                        "default": [],
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "note_number": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "src_ref",
                      "raw",
                      "kind",
                      "footnote_refs"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "cells"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "src_table",
          "must_appear",
          "table_type",
          "header_matrix",
          "unit_context",
          "row_groups",
          "rows"
        ],
        "additionalProperties": false
      }
    },
    "footnotes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "marker": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "src_ref": {
            "$ref": "#/$defs/__schema1"
          }
        },
        "required": [
          "id",
          "marker",
          "text",
          "src_ref"
        ],
        "additionalProperties": false
      }
    },
    "mapping_review": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "node_id": {
            "$ref": "#/$defs/__schema1"
          },
          "proposed_kind": {
            "$ref": "#/$defs/__schema0"
          },
          "confidence": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "accepted",
              "reassigned"
            ]
          }
        },
        "required": [
          "node_id",
          "proposed_kind",
          "confidence",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "doc_model_id",
    "extraction_id",
    "content_hash",
    "meta",
    "sections",
    "tables",
    "footnotes",
    "mapping_review"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "enum": [
        "cover",
        "highlights",
        "reviewOfOperations",
        "shareholderInfo",
        "stockTraded",
        "issuedCapital",
        "marketCap",
        "letter",
        "statement",
        "cashReconciliation",
        "note",
        "segments",
        "dividendDeclaration",
        "directors",
        "directorsReport",
        "accountingPolicies",
        "forwardLooking",
        "contacts",
        "disclaimers",
        "other"
      ]
    },
    "__schema1": {
      "type": "string",
      "pattern": "^ext:"
    }
  }
}
