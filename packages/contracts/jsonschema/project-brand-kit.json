{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "brand-kit/1"
    },
    "project_id": {
      "type": "string"
    },
    "logo": {
      "default": null,
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "blob_path": {
              "$ref": "#/$defs/__schema0"
            },
            "mime": {
              "$ref": "#/$defs/__schema1"
            },
            "filename": {
              "$ref": "#/$defs/__schema2"
            },
            "uploaded_at": {
              "$ref": "#/$defs/__schema3"
            },
            "uploaded_by": {
              "$ref": "#/$defs/__schema4"
            },
            "bytes": {
              "$ref": "#/$defs/__schema5"
            }
          },
          "required": [
            "blob_path",
            "mime",
            "uploaded_at"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "hero": {
      "default": null,
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "blob_path": {
              "$ref": "#/$defs/__schema0"
            },
            "mime": {
              "$ref": "#/$defs/__schema1"
            },
            "filename": {
              "$ref": "#/$defs/__schema2"
            },
            "uploaded_at": {
              "$ref": "#/$defs/__schema3"
            },
            "uploaded_by": {
              "$ref": "#/$defs/__schema4"
            },
            "bytes": {
              "$ref": "#/$defs/__schema5"
            },
            "kind": {
              "default": "photo",
              "type": "string",
              "const": "photo"
            }
          },
          "required": [
            "blob_path",
            "mime",
            "uploaded_at",
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "updated_at": {
      "$ref": "#/$defs/__schema3"
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "logo",
    "hero",
    "updated_at"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1
    },
    "__schema1": {
      "type": "string",
      "minLength": 1
    },
    "__schema2": {
      "type": "string"
    },
    "__schema3": {
      "type": "string"
    },
    "__schema4": {
      "type": "string"
    },
    "__schema5": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
