# Dev defaults run credential-free:
QUEUE_BACKEND=memory        # memory | postgres
BLOB_BACKEND=fs             # fs | vercel
ARTIFACTS_DIR=.artifacts
MAX_PAGES=250

# Production (Railway):
# QUEUE_BACKEND=postgres
# BLOB_BACKEND=vercel
# DATABASE_URL=postgres://...        # shared extraction_jobs table with the portal
# BLOB_READ_WRITE_TOKEN=...
# WORKER_SERVICE_TOKEN=...           # must match the portal's value
# WEBHOOK_HMAC_KEY=...               # must match the portal's value
